# {{ ansible_managed }}
# Rotación de los archivos creados por /etc/rsyslog.d/60-cis.conf (CIS 6.1.2.4 / 6.1.2.7)
/var/log/secure
/var/log/mail
/var/log/mail.info
/var/log/mail.warn
/var/log/mail.err
/var/log/cron
/var/log/warn
/var/log/messages
/var/log/localmessages
{
	rotate 4
	weekly
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
